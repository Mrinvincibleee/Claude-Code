# Copy to `.env` and fill in. Anything prefixed EXPO_PUBLIC_ is bundled into the
# client, so only put public values (e.g. the Supabase anon key) here.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI Coach — URL of the Supabase Edge Function that proxies the Claude API.
# Leave blank to run the coach in offline demo mode.
EXPO_PUBLIC_AI_COACH_URL=

# Server-only secrets (used by Edge Functions / backend, NOT bundled):
#   ANTHROPIC_API_KEY=
#   STRIPE_SECRET_KEY=
